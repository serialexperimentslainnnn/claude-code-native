<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="dev.lain.claudejb.shared"/>
        <plugin id="com.intellij.modules.jcef"/>
        <module name="intellij.platform.ui.jcef"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Claude Code"
                    anchor="right"
                    icon="/icons/toolwindow.svg"
                    canCloseContents="true"
                    factoryClass="dev.lain.claudejb.frontend.window.ClaudeToolWindowFactory"/>
    </extensions>
</idea-plugin>
